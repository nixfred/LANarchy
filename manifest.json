{
  "schemaVersion": 1,
  "id": "donnie.homelab-mesh",
  "name": "Lanarchy",
  "version": "0.3.12",
  "author": "Donnie Fiander",
  "license": "MIT",
  "description": "Homelab status map and list in the Omarchy bar — machines, Caddy services, UniFi, and Find hosts.",
  "homepage": "https://github.com/DonnieFi/OmarPlugs",
  "repository": "https://github.com/DonnieFi/OmarPlugs",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Lanarchy",
    "description": "Letterbox topology map and machines / LAN / proxy health.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
